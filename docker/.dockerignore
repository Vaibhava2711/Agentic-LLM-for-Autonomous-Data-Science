# Files ignored during Docker build
# These files will not be copied into the image

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/

# IDE config
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Temporary files
*.log
*.tmp
.DS_Store

# Large archives
*.tar
*.tar.gz
*.zip
*.safetensors
*.bin

# Model weights (mount at runtime)
models/
checkpoints/
